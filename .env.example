# Servidor
PORT=4000
NODE_ENV=development

# Base de datos (PostgreSQL)
DATABASE_URL=postgres://usuario:password@localhost:5432/betting_platform

# Auth
# Generalo con: openssl rand -hex 32 — no reutilices el de este archivo, es
# solo un placeholder y nunca debe llegar a producción.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# CORS — en producción, la URL exacta de tu frontend deployado
# (ej. https://tu-app.vercel.app). Sin esto, la API acepta requests desde
# cualquier origen (cómodo en desarrollo local, no en producción).
ALLOWED_ORIGIN=

# Reglas de negocio
MIN_AGE_YEARS=18
# Verificación de correo
# URL pública del frontend: se usa para armar el link del correo
# (ej. https://tu-app.vercel.app, sin "/" al final). Si no la defines, cae a ALLOWED_ORIGIN.
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_HOURS=24

# Remitente. Con Brevo debe ser un remitente verificado en su panel.
EMAIL_FROM=Palco <tu-correo-verificado@ejemplo.com>

# --- Proveedor de correo: define UNO. Prioridad: Brevo > Resend > SMTP ---
# Render plan gratis BLOQUEA los puertos SMTP (25/465/587): usa una API por HTTPS.

# Opción A (recomendada en Render gratis): API de Brevo. Clave en Brevo > SMTP & API > API Keys.
BREVO_API_KEY=

# Opción B: API de Resend (para enviar a cualquier persona necesitas un dominio verificado).
RESEND_API_KEY=

# Opción C: SMTP clásico (no funciona en Render gratis; sí en local o en planes de pago).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Si no defines ningún proveedor: en desarrollo el link de verificación se imprime
# en la consola del servidor; en producción el envío falla.
